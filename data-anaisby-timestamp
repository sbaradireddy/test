# =============================================================================
# AWS Glue Notebook — Per-VIN time-window TAGGING  (NO aggregation)
# Source : Parquet on S3   ->   Output : CSV on S3
# Windows: 1 minute / 15 minutes / 1 hour
#
# WHAT THIS DOES (vs. the old aggregation version):
#   - Keeps ALL columns and ALL rows  (SELECT *)
#   - Adds window_start / window_end columns marking the 1min / 15min / 1hour
#     bucket each row falls into
#   - Sorts by metaData_vehicleId, metaData_vin, window_start so each vehicle's
#     readings sit together, time-ordered
#   - NO sum / avg / min / max / std  -> nothing is collapsed
#
# Why "order by" and not "group by": a real GROUP BY vin, vehicle_id collapses
# many rows into one and REQUIRES aggregation. To keep every column with its
# own data, we tag + sort instead.
#
# HOW TO USE
#   - Notebook: paste each "# %% CELL" block into its own cell.
#   - Job script: paste the whole file (magics are ignored as comments).
#   Edit the two S3 paths in CELL 3. Run top to bottom.
# =============================================================================


# %% CELL 1 — Glue interactive session config (notebook only)
%idle_timeout 60
%glue_version 4.0
%worker_type G.1X
%number_of_workers 5


# %% CELL 2 — Imports + Spark/Glue context
import sys
from awsglue.utils import getResolvedOptions
from pyspark.context import SparkContext
from awsglue.context import GlueContext
from awsglue.job import Job
from pyspark.sql import functions as F
from pyspark.sql.types import NumericType, TimestampType, StringType

sc = SparkContext.getOrCreate()
glueContext = GlueContext(sc)
spark = glueContext.spark_session
job = Job(glueContext)


# %% CELL 3 — EDIT THESE TWO PATHS
SRC_PARQUET = "s3://YOUR-BUCKET/path/to/source/parquet/"                                                  # <-- your source
DST_CSV     = "s3://pske-stg-maintenance/projects/ard-iot-data-analysis/data-analysis-vin-vehicleid/"    # <-- output base

# Fixed for your dataset:
TS_COL     = "metaData_start"                       # timestamp to bucket on
GROUP_COLS = ["metaData_vehicleId", "metaData_vin"] # vehicle id + vin

# window label -> floor size in seconds
WINDOWS = {"1min": 60, "15min": 900, "1hour": 3600}

print("Source:", SRC_PARQUET)
print("Output:", DST_CSV)


# %% CELL 4 — Read Parquet + parse timestamp  (NO casting, NO aggregation)
df = spark.read.parquet(SRC_PARQUET)

ORIGINAL_COLS = df.columns                          # capture all source columns BEFORE adding helpers
print("Raw rows   :", df.count())
print("Columns    :", len(ORIGINAL_COLS))

# Robust timestamp parse: real timestamp / epoch-ms / epoch-s / ISO string
dt = df.schema[TS_COL].dataType
ts = F.col(TS_COL)
if isinstance(dt, TimestampType):
    ts_expr = ts
elif isinstance(dt, NumericType):
    ts_expr = (F.when(ts > F.lit(1_000_000_000_000), F.timestamp_millis(ts.cast("long")))
                .otherwise(F.timestamp_seconds(ts.cast("long"))))
else:  # string
    ts_expr = F.coalesce(
        F.to_timestamp(ts),                         # ISO-8601 e.g. 2026-05-28T16:55:03Z
        F.timestamp_millis(ts.cast("long")),        # epoch ms stored as text
        F.timestamp_seconds(ts.cast("long")),       # epoch s stored as text
    )

df = df.withColumn("_event_ts", ts_expr)

bad = df.filter(F.col("_event_ts").isNull()).count()
print("Unparseable timestamps:", bad, "(these rows get null window_start)")


# %% CELL 5 — Tag rows per window, keep ALL columns, sort, write CSV
# Column order in output: vehicleId, vin, window_start, window_end, <all other original cols>
other_cols = [c for c in ORIGINAL_COLS if c not in GROUP_COLS]

for label, secs in WINDOWS.items():
    epoch  = F.unix_timestamp("_event_ts")
    floor_ = (F.floor(epoch / F.lit(secs)) * F.lit(secs))

    out = (
        df
        .withColumn("window_start", F.from_unixtime(floor_).cast("timestamp"))
        .withColumn("window_end",   F.from_unixtime(floor_ + F.lit(secs)).cast("timestamp"))
        .select(*GROUP_COLS, "window_start", "window_end", *other_cols)   # SELECT *  (+ window cols)
        .orderBy(*GROUP_COLS, "window_start")                             # group rows by vehicle, time-ordered
    )

    dest = DST_CSV.rstrip("/") + "/" + label + "/"
    (out.coalesce(1)                          # one CSV file per window; drop coalesce() if data is large
        .write.mode("overwrite")
        .option("header", True)
        .csv(dest))

    print(f"[{label}] rows: {out.count():>10}  ->  {dest}")

print("Done. Subfolders written: /1min  /15min  /1hour")
