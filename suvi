from pyspark.sql import functions as F

df = spark.read.parquet(INPUT_PATH)          # your source parquet
df.createOrReplaceTempView("sensor")         # lets you use SQL

# A) ALL columns, organized per truck (vin + vehicle_id)
spark.sql("""
    SELECT *
    FROM sensor
    ORDER BY metaData_vin, metaData_vehicleId
""").show(50, truncate=False)

# B) DataFrame API equivalent
df.orderBy("metaData_vin", "metaData_vehicleId").show(50, truncate=False)

# C) One row per truck with how many records each has (true GROUP BY)
spark.sql("""
    SELECT metaData_vin, metaData_vehicleId, COUNT(*) AS record_count
    FROM sensor
    GROUP BY metaData_vin, metaData_vehicleId
    ORDER BY metaData_vin
""").show(50, truncate=False)

# D) Just one specific truck
df.filter(F.col("metaData_vin") == "PUT_A_VIN_HERE").show(50, truncate=False)
