from pyspark.sql import functions as F

df = spark.read.parquet(INPUT_PATH)          # your source parquet
df.createOrReplaceTempView("sensor")

# A) ALL columns, organized per truck (vin only)
spark.sql("""
    SELECT *
    FROM sensor
    ORDER BY metaData_vin
""").show(50, truncate=False)

# B) DataFrame API equivalent
df.orderBy("metaData_vin").show(50, truncate=False)

# C) One row per VIN with how many records each has
spark.sql("""
    SELECT metaData_vin, COUNT(*) AS record_count
    FROM sensor
    GROUP BY metaData_vin
    ORDER BY metaData_vin
""").show(50, truncate=False)

# D) Just one specific VIN
df.filter(F.col("metaData_vin") == "PUT_A_VIN_HERE").show(50, truncate=False)
